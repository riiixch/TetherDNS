generator client {
    provider = "prisma-client"
    output   = "./../server/lib/prisma"
}

datasource db {
    provider = "sqlite"
}

model CloudflareAccount {
    id           Int                @id @default(autoincrement())
    providerType String             @default("cloudflare")
    label        String
    email        String?
    apiToken     String
    zones        Zone[]
    tunnels      CloudflareTunnel[]
    createdAt    DateTime           @default(now())
}

model Zone {
    id        Int                @id @default(autoincrement())
    cfZoneId  String             @unique
    name      String
    accountId Int?
    account   CloudflareAccount? @relation(fields: [accountId], references: [id])
    records   DnsRecord[]
}

model User {
    id               Int        @id @default(autoincrement())
    username         String     @unique
    password         String
    twoFactorSecret  String?
    twoFactorEnabled Boolean    @default(false)
    auditLogs        AuditLog[]
    apiTokens        ApiToken[]
    createdAt        DateTime   @default(now())
}

model ApiToken {
    id         Int       @id @default(autoincrement())
    name       String
    tokenHash  String    @unique
    userId     Int
    user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    lastUsedAt DateTime?
    createdAt  DateTime  @default(now())
}

model DnsRecord {
    id           Int         @id @default(autoincrement())
    cfRecordId   String      @unique
    name         String
    type         String
    content      String
    isAutoUpdate Boolean     @default(false)
    proxied      Boolean     @default(false)
    
    // Cloudflare Tunnel routing additions
    routingMode  String      @default("static") // "static" | "ddns" | "tunnel"
    tunnelId     String?
    localAddress String?
    
    updateToken  String?     @unique
    zoneId       Int
    zone         Zone         @relation(fields: [zoneId], references: [id])
    updateLogs   UpdateLog[]
    healthCheck  HealthCheck?
}

model HealthCheck {
    id                Int              @id @default(autoincrement())
    recordId          Int              @unique
    record            DnsRecord        @relation(fields: [recordId], references: [id], onDelete: Cascade)
    enabled           Boolean          @default(true)
    probeType         String           @default("HTTP") // "HTTP" | "TCP" | "PING"
    probeTarget       String           // e.g. "https://app.example.com/health" or "192.168.1.100:8080"
    expectedStatus    Int?             @default(200)
    intervalSeconds   Int              @default(60)
    timeoutSeconds    Int              @default(5)
    failureThreshold  Int              @default(3)
    successThreshold  Int              @default(2)
    backupIp          String           // Failover target IP
    backupProxied     Boolean          @default(true)
    currentStatus     String           @default("HEALTHY") // "HEALTHY" | "DEGRADED" | "DOWN" | "FAILOVER_ACTIVE"
    consecutiveFails  Int              @default(0)
    consecutivePasses Int              @default(0)
    lastCheckAt       DateTime?
    lastFailoverAt    DateTime?
    lastLatencyMs     Int?
    autoFailback      Boolean          @default(true)
    originalIp        String?          // Saved primary IP while failover is active
    originalProxied   Boolean?         // Saved primary proxied state
    history           HealthCheckLog[]
    createdAt         DateTime         @default(now())
}

model HealthCheckLog {
    id            Int         @id @default(autoincrement())
    healthCheckId Int
    healthCheck   HealthCheck @relation(fields: [healthCheckId], references: [id], onDelete: Cascade)
    status        String      // "PASS" | "FAIL"
    statusCode    Int?
    latencyMs     Int
    errorMessage  String?
    createdAt     DateTime    @default(now())
}

model CloudflareTunnel {
    id          Int               @id @default(autoincrement())
    tunnelId    String            @unique
    name        String
    token       String
    status      String            @default("inactive") // "active" | "inactive" | "degraded"
    connections String?           // JSON string of connections
    accountId   Int
    account     CloudflareAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
    createdAt   DateTime          @default(now())
}

model UpdateLog {
    id        Int       @id @default(autoincrement())
    oldIp     String?
    newIp     String
    status    String
    recordId  Int
    record    DnsRecord @relation(fields: [recordId], references: [id])
    message   String?
    createdAt DateTime  @default(now())
}

model Settings {
    id    Int    @id @default(autoincrement())
    key   String @unique
    value String
}

model NotificationChannel {
    id         Int       @id @default(autoincrement())
    type       String    // "discord" | "telegram" | "email" | "line" | "webhook"
    label      String
    config     String    // encrypted JSON
    enabled    Boolean   @default(true)
    events     String    @default("[\"DDNS\",\"FAILOVER\",\"TUNNEL\",\"SECURITY\"]")
    lastUsedAt DateTime?
    createdAt  DateTime  @default(now())
}

model AuditLog {
    id        Int      @id @default(autoincrement())
    userId    Int
    user      User     @relation(fields: [userId], references: [id])
    action    String
    target    String
    details   String?
    createdAt DateTime @default(now())
}
